# Lightweight image that serves a dist/ built on the host.
# Used to avoid the memory-heavy in-container webpack build (node stage),
# which was crashing Docker Desktop's buildkit. Build dist/ with `yarn build`
# (REACT_APP_* env vars set) before building this image.
FROM nginx:alpine

# Copy pre-built application
COPY dist /usr/share/nginx/html

# Copy offline css, js, and libs
COPY ./public/css /usr/share/nginx/html/css
COPY ./public/js /usr/share/nginx/html/js
COPY ./public/libs /usr/share/nginx/html/libs

# Copy NGINX configuration file
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
