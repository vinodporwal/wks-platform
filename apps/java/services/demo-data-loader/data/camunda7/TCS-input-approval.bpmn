<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_1"
    targetNamespace="http://example.com/eps">

  <bpmn:process id="TCS_APPROVAL_PROCESS"
                name="EPS Multi-Form Approval"
                isExecutable="true"
                camunda:historyTimeToLive="180">

    <!-- Start -->
    <bpmn:startEvent id="StartEvent" name="Process Initiated"/>

 
    <bpmn:exclusiveGateway id="gw_loop_merge" name="Loop Merge"/>

    <bpmn:parallelGateway id="gw_parallel_fork" name="Fork"/>

    <bpmn:userTask id="SubmitPlantData" name="Submit Plant Data">
      <bpmn:multiInstanceLoopCharacteristics
          camunda:collection="${plantList}"
          camunda:elementVariable="plant"/>
    </bpmn:userTask>

    <!-- CTS Tech Approval task, parallel to SubmitPlantData -->
    <bpmn:userTask id="CTS_Tech_Approval" name="CTS Tech Approval">
      <bpmn:multiInstanceLoopCharacteristics
          camunda:collection="${plantList}"
          camunda:elementVariable="plant"/>
    </bpmn:userTask>

    <!-- Parallel Gateway: join — waits for BOTH tasks to complete -->
    <bpmn:parallelGateway id="gw_parallel_join" name="Join"/>

    <!-- Approval SubProcess -->
    <bpmn:subProcess id="ApprovalFlow" name="Approval Flow">

      <bpmn:startEvent id="SubStart"/>

      <!-- Stage 1 -->
      <bpmn:userTask id="AOM_Approval"
                     name="AOm Approval"
                     camunda:candidateGroups="AOM_ENGINEER"/>

      <bpmn:exclusiveGateway id="gw_aom"/>

      <!-- Stage 2 -->
      <bpmn:userTask id="CTS_APPROVAL"
                     name="CTS Approval"
                     camunda:candidateGroups="CTS_ENGINEER"/>

      <bpmn:exclusiveGateway id="gw_cts"/>

      <!-- Stage 3 -->
      <bpmn:userTask id="EPS_APPROVAL"
                     name="EPS Approval"
                     camunda:candidateGroups="EPS_ENGINEER"/>

      <bpmn:exclusiveGateway id="gw_eps"/>

      <!-- Stage 4 -->
      <bpmn:userTask id="Cluster_Head_APPROVAL"
                     name="Cluster Head Approval"
                     camunda:candidateGroups="Cluster_Head_ENGINEER"/>

      <bpmn:exclusiveGateway id="gw_cluster"/>

      <!-- Final -->
      <bpmn:userTask id="Pending_state"
                     name="Pending"
                     camunda:candidateGroups="Head_ENGINEER"/>

      <!-- End events -->
      <bpmn:endEvent id="SubEnd_Approved"/>
      <bpmn:endEvent id="SubEnd_Rejected"/>

      <!-- Flows -->
      <bpmn:sequenceFlow id="s1" sourceRef="SubStart" targetRef="AOM_Approval"/>

      <!-- AOM -->
      <bpmn:sequenceFlow id="s2" sourceRef="AOM_Approval" targetRef="gw_aom"/>
      <bpmn:sequenceFlow id="s3" sourceRef="gw_aom" targetRef="CTS_APPROVAL">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == true}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="s4" sourceRef="gw_aom" targetRef="SubEnd_Rejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == false}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- CTS -->
      <bpmn:sequenceFlow id="s5" sourceRef="CTS_APPROVAL" targetRef="gw_cts"/>
      <bpmn:sequenceFlow id="s6" sourceRef="gw_cts" targetRef="EPS_APPROVAL">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == true}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="s7" sourceRef="gw_cts" targetRef="SubEnd_Rejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == false}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- EPS -->
      <bpmn:sequenceFlow id="s_eps1" sourceRef="EPS_APPROVAL" targetRef="gw_eps"/>
      <bpmn:sequenceFlow id="s_eps2" sourceRef="gw_eps" targetRef="Cluster_Head_APPROVAL">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == true}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="s_eps3" sourceRef="gw_eps" targetRef="SubEnd_Rejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == false}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- Cluster -->
      <bpmn:sequenceFlow id="s8" sourceRef="Cluster_Head_APPROVAL" targetRef="gw_cluster"/>
      <bpmn:sequenceFlow id="s9" sourceRef="gw_cluster" targetRef="Pending_state">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == true}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="s10" sourceRef="gw_cluster" targetRef="SubEnd_Rejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
          ${approved == false}
        </bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <!-- Final -->
      <bpmn:sequenceFlow id="s11" sourceRef="Pending_state" targetRef="SubEnd_Approved"/>

    </bpmn:subProcess>

    <!-- End -->
    <bpmn:endEvent id="EndEvent" name="Process Completed"/>

    <!-- ═══════════════════════════════════════════
         MAIN FLOW
         ═══════════════════════════════════════════ -->

    <!-- Start → Loop Merge (XOR) -->
    <bpmn:sequenceFlow id="flow0"  sourceRef="StartEvent"       targetRef="gw_loop_merge"/>

    <!-- FIX: rejection loop now targets the XOR merge, NOT the parallel fork -->
    <bpmn:sequenceFlow id="flow4"  sourceRef="ApprovalFlow"     targetRef="gw_loop_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${approved == false}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Loop Merge (XOR) → Parallel Fork -->
    <bpmn:sequenceFlow id="flow0b" sourceRef="gw_loop_merge"    targetRef="gw_parallel_fork"/>

    <!-- Fork → SubmitPlantData -->
    <bpmn:sequenceFlow id="flow1a" sourceRef="gw_parallel_fork" targetRef="SubmitPlantData"/>

    <!-- Fork → CTS_Tech_Approval -->
    <bpmn:sequenceFlow id="flow1b" sourceRef="gw_parallel_fork" targetRef="CTS_Tech_Approval"/>

    <!-- SubmitPlantData → Join -->
    <bpmn:sequenceFlow id="flow2a" sourceRef="SubmitPlantData"  targetRef="gw_parallel_join"/>

    <!-- CTS_Tech_Approval → Join -->
    <bpmn:sequenceFlow id="flow2b" sourceRef="CTS_Tech_Approval" targetRef="gw_parallel_join"/>

    <!-- Join → ApprovalFlow (both tasks must be done) -->
    <bpmn:sequenceFlow id="flow2"  sourceRef="gw_parallel_join" targetRef="ApprovalFlow"/>

    <!-- Approved → End -->
    <bpmn:sequenceFlow id="flow3"  sourceRef="ApprovalFlow"     targetRef="EndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${approved == true}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- ═══════════════════════════════════════════
       DIAGRAM (DI) — updated to include gw_loop_merge shape/edge
       ═══════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="TCS_APPROVAL_PROCESS">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- XOR Loop Merge (NEW) -->
      <bpmndi:BPMNShape id="gw_loop_merge_di" bpmnElement="gw_loop_merge" isMarkerVisible="true">
        <dc:Bounds x="185" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Parallel Fork -->
      <bpmndi:BPMNShape id="gw_parallel_fork_di" bpmnElement="gw_parallel_fork">
        <dc:Bounds x="290" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- SubmitPlantData -->
      <bpmndi:BPMNShape id="SubmitPlantData_di" bpmnElement="SubmitPlantData">
        <dc:Bounds x="400" y="120" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <!-- CTS Tech Approval -->
      <bpmndi:BPMNShape id="CTS_Tech_Approval_di" bpmnElement="CTS_Tech_Approval">
        <dc:Bounds x="400" y="260" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Parallel Join -->
      <bpmndi:BPMNShape id="gw_parallel_join_di" bpmnElement="gw_parallel_join">
        <dc:Bounds x="600" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- SubProcess -->
      <bpmndi:BPMNShape id="ApprovalFlow_di" bpmnElement="ApprovalFlow" isExpanded="true">
        <dc:Bounds x="700" y="100" width="800" height="300"/>
      </bpmndi:BPMNShape>

      <!-- End Event -->
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="1530" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Edges -->

      <!-- Start → XOR Merge -->
      <bpmndi:BPMNEdge id="flow0_di" bpmnElement="flow0">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="185" y="218"/>
      </bpmndi:BPMNEdge>

      <!-- XOR Merge → Parallel Fork -->
      <bpmndi:BPMNEdge id="flow0b_di" bpmnElement="flow0b">
        <di:waypoint x="235" y="218"/>
        <di:waypoint x="290" y="218"/>
      </bpmndi:BPMNEdge>

      <!-- Fork → SubmitPlantData -->
      <bpmndi:BPMNEdge id="flow1a_di" bpmnElement="flow1a">
        <di:waypoint x="315" y="193"/>
        <di:waypoint x="315" y="160"/>
        <di:waypoint x="400" y="160"/>
      </bpmndi:BPMNEdge>

      <!-- Fork → CTS Tech Approval -->
      <bpmndi:BPMNEdge id="flow1b_di" bpmnElement="flow1b">
        <di:waypoint x="315" y="243"/>
        <di:waypoint x="315" y="300"/>
        <di:waypoint x="400" y="300"/>
      </bpmndi:BPMNEdge>

      <!-- SubmitPlantData → Join -->
      <bpmndi:BPMNEdge id="flow2a_di" bpmnElement="flow2a">
        <di:waypoint x="540" y="160"/>
        <di:waypoint x="625" y="160"/>
        <di:waypoint x="625" y="193"/>
      </bpmndi:BPMNEdge>

      <!-- CTS Tech Approval → Join -->
      <bpmndi:BPMNEdge id="flow2b_di" bpmnElement="flow2b">
        <di:waypoint x="540" y="300"/>
        <di:waypoint x="625" y="300"/>
        <di:waypoint x="625" y="243"/>
      </bpmndi:BPMNEdge>

      <!-- Join → ApprovalFlow -->
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="650" y="218"/>
        <di:waypoint x="700" y="218"/>
      </bpmndi:BPMNEdge>

      <!-- ApprovalFlow → End (approved) -->
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="1500" y="218"/>
        <di:waypoint x="1530" y="218"/>
      </bpmndi:BPMNEdge>

      <!-- ApprovalFlow → XOR Merge (rejected — loops back) -->
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="1500" y="260"/>
        <di:waypoint x="1500" y="420"/>
        <di:waypoint x="210"  y="420"/>
        <di:waypoint x="210"  y="243"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
