# =============================================================================
# WKS Platform — environment template for the Camunda 7 full stack
# (docker-full-startup.sh). Copy to `.env` and fill every TODO before running:
#     cp .env.example .env
#
# Values marked TODO are environment-specific (secrets, external services, or
# the exact Keycloak realm) and MUST be set. Other values are working defaults
# that match the container network in the docker-compose files.
#
# PREREQUISITES for the AOP approval test run:
#   1. Build the c7-plugins jar so Camunda can load the gate listener:
#         (cd apps/java && JAVA_HOME=<jdk17> mvn -o -pl libraries/c7-plugins -am package -DskipTests)
#      The event-hub compose mounts target/c7-plugins-1.0-SNAPSHOT.jar into
#      Camunda's userlib/ — without it, AopGateDecisionListener won't resolve.
#   2. CAMUNDA_DOCKER_IMAGE/VERSION MUST be the Camunda *Run* distribution
#      (it uses /camunda/configuration/userlib/). run-7.20.0 is the tested line.
#   3. After the stack is healthy, run against the RIL.AOP SQL Server:
#         sql/AOP_Approval_Workflow_Seed.sql        (set @VerticalName first)
#         sql/AOP_Approval_Workflow_UniqueIndex.sql
#   4. Create the 11 Keycloak realm roles (cts_lead, production_manager,
#      plant_manager, operation_head, technology_vertical_head, cts_head,
#      fca_head, maintenance_head, site_head, gms_business_head, gms_head)
#      and assign test users with email addresses.
# =============================================================================

# ---- Camunda 7 (Run distribution — required for userlib plugin mount) -------
CAMUNDA_DOCKER_IMAGE=camunda/camunda-bpm-platform
CAMUNDA7_VERSION=run-7.20.0            # TODO confirm the exact Run tag used
CAMUNDA_BASE_URL=http://camunda:8080/engine-rest
CAMUNDA_USERNAME=demo
CAMUNDA_PASSWORD=demo

# ---- MongoDB (WKS case store) -----------------------------------------------
MONGO_CONNECTION_URL=mongodb://mongodb:27017
MONGO_WKS_DATABASE=wks
MONGO_DEMO_DATA_LOADER_DATABASE=wks

# ---- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM_NAME=wks-platform       # TODO confirm the app realm name
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/wks-platform/protocol/openid-connect/token
KEYCLOAK_DATA_IMPORT_REALM_DISPLAY_NAME=WKS Platform
KEYCLOAK_DEFAULT_USER=admin
KEYCLOAK_DEFAULT_USER_PASSWORD=admin
KEYCLOAK_DEFAULT_USER_EMAIL=admin@example.com
KEYCLOAK_DEFAULT_USER_FIRST_NAME=Admin
KEYCLOAK_DEFAULT_USER_LAST_NAME=User

# ---- OPA (authorization) -----------------------------------------------------
OPA_URL=http://opa:8181

# ---- Kafka (event hub) -------------------------------------------------------
KAFKA_URL=kafka:9093
KAFKA_TOPIC_CASE_CREATE=case-create
KAFKA_TOPIC_CREATE_HUMAN_TASK=human-task-create
KAFKA_TOPIC_CASE_EMAIL_OUTBOUND=case-email-outbound

# ---- MinIO (storage) ---------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin         # TODO set a real secret
MINIO_HOST_INTERNAL=http://minio:9000
MINIO_HOST_EXTERNAL=http://localhost:9000

# ---- Postgres (Keycloak DB) --------------------------------------------------
POSTGRES_USER=keycloak

# ---- Backend / external-task worker -----------------------------------------
WKS_CASE_API_URL=http://case-engine-rest-api:8081
DISABLE_BACKOFF_STRATEGY=false
WEBSOCKET_ENABLED=false
WEBSOCKET_URL=ws://localhost:8087
WEBSOCKET_LOG_LEVEL=info

# ---- Mail-to-case JWT client (email-sender) ---------------------------------
MAIL_TO_CASE_JWT_TOKEN_CLIENT_ID=wks-platform      # TODO confirm
MAIL_TO_CASE_JWT_TOKEN_CLIENT_SECRET=              # TODO set client secret
MAIL_TO_CASE_JWT_TOKEN_GRANT_TYPE=client_credentials
EMAIL_SENDER_LOG_LEVEL=info

# ---- Novu (optional notifications) ------------------------------------------
NOVU_ENABLED=false
NOVU_LOG_LEVEL=info
NOVU_API_KEY=                          # TODO if NOVU_ENABLED=true
NOVU_APP_ID=                           # TODO if NOVU_ENABLED=true
NOVU_TRIGGER_URL=https://api.novu.co/v1/events/trigger
NOVU_PUBLISHER_API_URL=http://localhost:3002

# ---- React portal (BUILD-TIME args — must be browser-reachable) -------------
REACT_APP_API_URL=http://localhost:8081
REACT_APP_KEYCLOAK_URL=http://localhost:8082
REACT_APP_STORAGE_URL=http://localhost:8085

# ---- Camunda 8 (NOT used by docker-full-startup.sh; leave blank) ------------
CAMUNDA8_PLATFORM_VERSION=
CAMUNDA8_CONNECTORS_VERSION=
CAMUNDA8_ELASTIC_VERSION=
CAMUNDA8_ZEEBE_GATEWAY_ADDRESS=
CAMUNDA8_OPERATE_URL=
CAMUNDA8_OPERATE_USERNAME=
CAMUNDA8_OPERATE_PASSWORD=
CAMUNDA8_TASKLIST_URL=
CAMUNDA8_TASKLIST_USERNAME=
CAMUNDA8_TASKLIST_PASSWORD=
