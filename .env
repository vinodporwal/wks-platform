# =====================================================================
# Local-dev environment for WKS Platform (full stack)
# Generated for local docker-compose deployment.
# Override any value with real secrets for non-local environments.
# =====================================================================

# ---------- MinIO (object storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST_INTERNAL=http://minio:9000
MINIO_HOST_EXTERNAL=http://localhost:9000

# ---------- Keycloak (identity) ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Internal URL used by backend services (Keycloak serves under /cm relative path)
KEYCLOAK_URL=http://keycloak:8080/cm
KEYCLOAK_TOKEN_URL=http://keycloak:8080/cm/realms/localhost/protocol/openid-connect/token
# Default user seeded by demo-data-loader
KEYCLOAK_DEFAULT_USER=admin
KEYCLOAK_DEFAULT_USER_PASSWORD=admin
KEYCLOAK_DEFAULT_USER_EMAIL=admin@wkspower.local
KEYCLOAK_DEFAULT_USER_FIRST_NAME=Admin
KEYCLOAK_DEFAULT_USER_LAST_NAME=User

# ---------- OPA (policy) ----------
OPA_URL=http://opa:8181/v1/data/wks/authz/allow

# ---------- MongoDB ----------
MONGO_CONNECTION_URL=mongodb://mongodb:27017
MONGO_WKS_DATABASE=shared
MONGO_DEMO_DATA_LOADER_DATABASE=localhost

# ---------- Camunda 7 ----------
CAMUNDA_DOCKER_IMAGE=camunda/camunda-bpm-platform
CAMUNDA7_VERSION=run-7.20.0
CAMUNDA_BASE_URL=http://camunda:8080/engine-rest
CAMUNDA_USERNAME=demo
CAMUNDA_PASSWORD=demo

# ---------- Kafka / Event Hub ----------
KAFKA_URL=kafka:9093
KAFKA_TOPIC_CASE_CREATE=case-create
KAFKA_TOPIC_CREATE_HUMAN_TASK=human-task-create
KAFKA_TOPIC_CASE_EMAIL_OUTBOUND=case-email-outbound

# ---------- WKS case API ----------
WKS_CASE_API_URL=http://case-engine-rest-api:8081/cm
REACT_FRONTEND_URL=http://localhost:3001

# ---------- WebSocket publisher ----------
WEBSOCKET_ENABLED=true
WEBSOCKET_LOG_LEVEL=info
WEBSOCKET_URL=ws://localhost:8484

# ---------- Novu (notifications) - disabled by default for local ----------
NOVU_ENABLED=false
NOVU_LOG_LEVEL=info
NOVU_PUBLISHER_API_URL=http://localhost:3002
NOVU_TRIGGER_URL=
NOVU_API_KEY=
NOVU_APP_ID=

# ---------- Email sender ----------
EMAIL_SENDER_LOG_LEVEL=info
MAIL_TO_CASE_JWT_TOKEN_CLIENT_ID=wks-portal
MAIL_TO_CASE_JWT_TOKEN_CLIENT_SECRET=
MAIL_TO_CASE_JWT_TOKEN_GRANT_TYPE=client_credentials

# ---------- React portal (build-time args) ----------
REACT_APP_API_URL=http://localhost:8081/cm
REACT_APP_KEYCLOAK_URL=http://localhost:8082/cm
REACT_APP_STORAGE_URL=http://localhost:8085

# ---------- GE external authentication APIs (environment-specific; left blank for local) ----------
GE_AUTHENTICATION_DATASOURCE=
GE_AUTHENTICATION_ID=
GE_AUTHENTICATION_PASSWORD=
GE_AUTHENTICATION_API=
GE_USERS_API=
GE_CREATE_CASE_API=
GE_CASE_STATUS_API=

# ---------- Misc ----------
DISABLE_BACKOFF_STRATEGY=true

# ---------- case-engine SQL Server datasources ----------
# Fill in real host/credentials per environment. Must be reachable from the
# case-engine container for the SQL-backed features to work.
SQL_SERVER_1=db1
SQL_SERVER_1_URL=jdbc:sqlserver://<DB_HOST>;databaseName=<DB_NAME>;trustServerCertificate=true
SQL_SERVER_1_USERNAME=<DB_USER>
SQL_SERVER_1_PASSWORD=<DB_PASSWORD>

SQL_SERVER_2_URL=jdbc:sqlserver://<DB_HOST>;databaseName=<DB_NAME>;trustServerCertificate=true
SQL_SERVER_2_USERNAME=<DB_USER>
SQL_SERVER_2_PASSWORD=<DB_PASSWORD>

SQL_SERVER_3_URL=jdbc:sqlserver://<DB_HOST>;databaseName=<DB_NAME>;trustServerCertificate=true
SQL_SERVER_3_USERNAME=<DB_USER>
SQL_SERVER_3_PASSWORD=<DB_PASSWORD>

SQL_SERVER_4_URL=jdbc:sqlserver://<DB_HOST>;databaseName=<DB_NAME>;trustServerCertificate=true
SQL_SERVER_4_USERNAME=<DB_USER>
SQL_SERVER_4_PASSWORD=<DB_PASSWORD>

# ---------- case-engine SMTP (mail) ----------
SMTP_HOST=smtp-secure.honeywell.com
SMTP_PORT=587
SMTP_USERNAME=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM_EMAIL=<SMTP_FROM_EMAIL>
